generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  COUNSELOR
  ADMIN
}

model User {
  id         String          @id @default(cuid())
  email      String          @unique
  password   String
  name       String?
  role       UserRole        @default(STUDENT)
  ieltsScore Int?
  greScore   Int?
  createdAt  DateTime        @default(now())
  savedUnis  UserSavedUni[]
}

model University {
  id         String          @id @default(cuid())
  name       String
  country    String
  qsRanking  Int?
  ownRanking Int?
  tuitionFee Int?
  ieltsReq   Float?
  greReq     Int?
  savedBy    UserSavedUni[]
}

model UserSavedUni {
  id            String      @id @default(cuid())
  userId        String
  universityId  String
  savedAt       DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  university    University  @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([userId, universityId])
  @@index([userId])
  @@index([universityId])
}
